# Use Nginx Alpine base image
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Set working directory
WORKDIR /usr/share/nginx/html

# Create health endpoint
RUN echo '{"status": "healthy"}' > /usr/share/nginx/html/health

# Create simple HTML page
RUN cat > /usr/share/nginx/html/index.html << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>INVASCAN Web Reporting</title>
</head>
<body>
    <h1>INVASCAN Web Reporting</h1>
    <p>API Status: <span id="status">Checking...</span></p>
    <p>Last Update: <span id="time">-</span></p>
    
    <script>
        function checkAPI() {
            fetch('/api/openapi.json')
                .then(response => {
                    if (response.ok) {
                        document.getElementById('status').textContent = 'Connected';
                        document.getElementById('status').style.color = 'green';
                    } else {
                        throw new Error('API not responding');
                    }
                })
                .catch(error => {
                    document.getElementById('status').textContent = 'Disconnected';
                    document.getElementById('status').style.color = 'red';
                })
                .finally(() => {
                    document.getElementById('time').textContent = new Date().toLocaleTimeString();
                });
        }
        
        // Check every 5 seconds
        checkAPI();
        setInterval(checkAPI, 5000);
    </script>
</body>
</html>
EOF

# Simple nginx config
RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 80;
    root /usr/share/nginx/html;

    location /health {
        return 200 '{"status": "healthy"}';
    }

    location /api/ {
        proxy_pass http://invascanapi_container:80/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]