# Use a slim Python base image for efficiency
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create a status endpoint file
RUN mkdir -p /app/api
RUN echo '{"status": "running", "service": "Data Sync Service"}' > /app/api/status.json

# Expose port
EXPOSE 8081

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Create and set permissions for entrypoint script
RUN echo '#!/bin/bash\npython /app/main.py' > /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Use exec form for proper signal handling
ENTRYPOINT ["/app/entrypoint.sh"]