FROM python:3.9-slim

WORKDIR /app

# Create a simple API application
RUN mkdir -p /app/api
RUN echo '{"status": "running", "service": "Data Sync Service"}' > /app/api/status.json

# Expose ports
EXPOSE 8081

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Create a simple entrypoint script
RUN echo '#!/bin/bash\nwhile true; do echo "Data Sync Service running..."; sleep 60; done' > /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]