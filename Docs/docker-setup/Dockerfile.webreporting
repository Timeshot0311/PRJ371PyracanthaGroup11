FROM nginx:alpine

WORKDIR /usr/share/nginx/html

# Create a simple HTML page
RUN echo '<html><head><title>INVASCAN Web Reporting</title></head><body><h1>INVASCAN Web Reporting</h1><p>This is a placeholder for the web reporting interface.</p></body></html>' > /usr/share/nginx/html/index.html

# Create a status endpoint
RUN mkdir -p /usr/share/nginx/html/api
RUN echo '{"status": "running", "service": "Web Reporting Interface"}' > /usr/share/nginx/html/api/status.json

# Expose ports
EXPOSE 80

# Use default nginx entrypoint
CMD ["nginx", "-g", "daemon off;"]