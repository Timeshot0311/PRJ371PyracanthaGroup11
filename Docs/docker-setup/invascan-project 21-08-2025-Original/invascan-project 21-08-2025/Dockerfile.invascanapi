# Use ASP.NET Core runtime image
FROM mcr.microsoft.com/dotnet/aspnet:6.0

# Set working directory
WORKDIR /app

# Copy published application
COPY ./publish .

# Create a status endpoint file
RUN mkdir -p /app/wwwroot
RUN echo '{"status": "running", "service": "INVASCAN API"}' > /app/wwwroot/status.json

# Expose ports
EXPOSE 80
EXPOSE 443

# Set environment variables
ENV ASPNETCORE_URLS=http://+:80

# Create and set permissions for entrypoint script
RUN echo '#!/bin/bash\ndotnet INVASCANAPI.dll' > /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Use exec form for proper signal handling
ENTRYPOINT ["/app/entrypoint.sh"]