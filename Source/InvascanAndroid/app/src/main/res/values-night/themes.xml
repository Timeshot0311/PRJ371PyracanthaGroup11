<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Invascan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

    <style name="Theme.Invascan" parent="Base.Theme.Invascan">
        <item name="colorPrimary">@color/white_700</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>

        <!-- Secondary branding -->
        <item name="colorSecondary">@color/white_700</item>
        <item name="colorOnSecondary">@color/c_teal</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">?attr/colorSurface</item>

        <item name="popupMenuStyle">@style/CustomPopupMenu</item>

        <!-- Text color for menu items -->
        <item name="android:textColor">#000000</item>

    </style>

    <style name="CustomPopupMenu" parent="@style/Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_background</item>

        <!-- Text color for menu items -->
        <item name="android:textColor">#000000</item>

        <!-- Optional: if you want pressed/selected background -->
        <item name="android:itemBackground">@drawable/menu_item_selector</item>
    </style>

</resources>