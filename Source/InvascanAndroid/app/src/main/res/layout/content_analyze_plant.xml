<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layout_marginTop="16dp"
    tools:context=".ui.analyze.AnalyzePlantActivity">

    <ScrollView
        android:id="@+id/scroll_main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="5dp"
        android:contentDescription="@string/app_name"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layout_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Input Image Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/inputImageContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/mcgpalette0_A200"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/button_card_container"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/black"
                app:cardElevation="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    app:layout_constraintTop_toBottomOf="@id/inputImageContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/upload_image_title"
                        android:textColor="@color/c_black"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="0dp"
                        android:gravity="start|center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cardDescription"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/cardDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/upload_image_description"
                        android:textColor="@color/c_black"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:layout_marginStart="0dp"
                        android:gravity="start|center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cardTitle"
                        app:layout_constraintBottom_toTopOf="@id/inputImage"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                        android:id="@+id/inputImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:contentDescription="@string/image_description"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_photo_gray_24"
                        android:background="@drawable/button_dotted_square"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cardDescription"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="8dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Button Container -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/button_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                app:layout_constraintTop_toBottomOf="@id/inputImageContainer"
                app:layout_constraintBottom_toTopOf="@+id/outputImageContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mainButtonsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/btnClearAll">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/actionButtonsContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/action_buttons_layout">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnLoadImageContainer"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:padding="1dp"
                            android:layout_margin="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_info_round"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnCameraImageContainer"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHorizontal_weight="0.5">
                            <ImageView
                                android:id="@+id/customButtonIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="@string/open_image"
                                android:src="@drawable/ic_open_folder"
                                app:tint="@color/twitter"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/customButtonText"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginStart="5dp" />
                            <TextView
                                android:id="@+id/customButtonText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/load_image"
                                android:textStyle="normal"
                                android:textColor="@color/twitter"
                                android:padding="10dp"
                                android:textAlignment="center"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toEndOf="@id/customButtonIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnCameraImageContainer"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:padding="2dp"
                            android:layout_margin="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_info_round"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@id/btnLoadImageContainer"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintHorizontal_weight="0.5">
                            <ImageView
                                android:id="@+id/customButtonCameraIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="@string/open_image"
                                android:src="@drawable/baseline_camera_24"
                                app:tint="@color/twitter"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/customButtonCameraText"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginStart="5dp" />
                            <TextView
                                android:id="@+id/customButtonCameraText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/camera_image"
                                android:textStyle="normal"
                                android:textColor="@color/twitter"
                                android:padding="10dp"
                                android:textAlignment="center"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toEndOf="@id/customButtonCameraIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/action_buttons_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/actionButtonsContainer"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btn_image_options"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp"
                            android:padding="1dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_warning_outline_square"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btnIdentifyContainer"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">

                            <TextView
                                android:id="@+id/btn_image_options_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/image_options"
                                android:textStyle="normal"
                                android:textColor="@color/orange_500"
                                android:padding="10dp"
                                android:textAlignment="center"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/btn_image_options_icon"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                            <ImageView
                                android:id="@+id/btn_image_options_icon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="@string/open_image"
                                android:src="@drawable/baseline_menu_24"
                                app:tint="@color/orange_500"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/btn_image_options_text"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginStart="5dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>



                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/btnIdentifyContainer"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginVertical="5dp"
                            android:layout_marginHorizontal="15dp"
                            android:padding="1dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_primary_round"
                            app:layout_constraintHorizontal_weight="0.7"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/btn_image_options"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/btn_identify_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/button_identify_text"
                                android:textStyle="normal"
                                android:textColor="#FFFFFF"
                                android:padding="10dp"
                                android:textAlignment="center"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btnIdentifyIcon"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>
                            <ImageView
                                android:id="@+id/btnIdentifyIcon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/open_image"
                                android:src="@drawable/baseline_database_search_24"
                                app:tint="@color/white"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/btn_identify_title"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginStart="5dp" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <Button
                    android:id="@+id/btnClearAll"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/clear_all"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:visibility="gone"
                    android:backgroundTint="@color/warning_orange"
                    app:flow_horizontalAlign="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/mainButtonsContainer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Output Image Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/outputImageContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="10dp"
                android:layout_marginVertical="10dp"
                android:visibility="visible"
                android:backgroundTint="@color/mcgpalette0_A200"
                app:strokeColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/button_card_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    app:layout_constraintTop_toBottomOf="@id/inputImageContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/card_detection_results_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/engine_response_title"
                        android:textColor="@color/c_black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginStart="0dp"
                        android:gravity="start|center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/card_detection_results_Description"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/card_detection_results_Description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/results_image_description"
                        android:textColor="@color/c_black"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:layout_marginStart="0dp"
                        android:gravity="start|center_vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card_detection_results_title"
                        app:layout_constraintBottom_toTopOf="@id/detection_results_image"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                        android:id="@+id/detection_results_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp"
                        android:contentDescription="@string/image_description"
                        android:scaleType="fitCenter"
                        android:src="@drawable/baseline_photo_gray_24"
                        android:background="@drawable/button_dotted_square"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/card_detection_results_Description"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/txtLabelNameTitle"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start|center_vertical"
                        android:text="@string/detected_name"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:padding="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/detection_results_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintVertical_bias="0"/>

                    <TextView
                        android:id="@+id/detect_label_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start|center_vertical"
                        android:text="......."
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:padding="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/detection_results_image"
                        app:layout_constraintStart_toEndOf="@+id/txtLabelNameTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintVertical_bias="0"/>

                    <TextView
                        android:id="@+id/txtLabelScoreTitle"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start|center_vertical"
                        android:text="@string/detected_score"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:padding="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/txtLabelNameTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintVertical_bias="0"/>

                    <TextView
                        android:id="@+id/detect_label_score"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start|center_vertical"
                        android:text="....."
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:padding="2dp"
                        app:layout_constraintTop_toBottomOf="@+id/detect_label_name"
                        app:layout_constraintStart_toEndOf="@+id/txtLabelScoreTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintVertical_bias="0"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!--region footer section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txt_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:fontFamily="@font/roboto"
            android:text="@string/app_footer"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txt_version"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />


        <TextView
            android:id="@+id/txt_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:fontFamily="@font/roboto"
            android:text="@string/app_version"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.970"
            app:layout_constraintStart_toEndOf="@+id/txt_footer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--endregion header section -->
</androidx.constraintlayout.widget.ConstraintLayout>