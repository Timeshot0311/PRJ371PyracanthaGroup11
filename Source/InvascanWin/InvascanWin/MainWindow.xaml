<Window x:Class="Invascan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Invascan"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Bisque">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Width="35" Height="35" Margin="10, 5">
                Min
            </Button>

            <Button Grid.Column="2" Width="35" Height="35" Margin="10, 5">
                X
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>

            <GroupBox Grid.Column="0" Grid.Row="0" Padding="5" Margin="5">
                <GroupBox.Header>
                    <TextBlock Text="REQUEST"></TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Image x:Name="RequestImagePreview" Grid.Row="0" Width="auto" Height="auto" Margin="5"></Image>
                    <Grid Grid.Row="1" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoadImageButton" Grid.Column="0" HorizontalAlignment="Center" Padding="8" Margin="10,5">
                            Load Image
                        </Button>

                        <Button x:Name="IdentifyImageButton" Grid.Column="1" HorizontalAlignment="Center" Padding="8" Margin="10,5">
                            Identify Image
                        </Button>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Grid.Row="0" Padding="5" Margin="5">
                <GroupBox.Header>
                    <TextBlock Text="API RESPONSE"></TextBlock>
                </GroupBox.Header>
            </GroupBox>

        </Grid>

        <Grid Grid.Row="0">

        </Grid>

    </Grid>
</Window>
